# Backend only. Copy to .env in the repository root.
# Use the key supplied at the event. Never put it in a VITE_ variable.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Relative to the repository root; never silently falls back to synthetic data.
ANALYST_DATA_DIR=data/market
